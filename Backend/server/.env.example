PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/certificate_db
CLERK_SECRET_KEY=sk_test_your_secret_key_here
FRONTEND_URL=http://localhost:5173
# Add comma-separated frontend origins when the site runs on multiple domains.
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://certifyvault.example
PASSKEY_RP_ID=localhost
CERTIFICATE_STORAGE_PATH=./private-certificates
# Public website origin used to build stable credential pages.
PUBLIC_CREDENTIAL_URL=http://localhost:5173
# API base used for backend-stored signed verification proofs and legacy PDF QR links.
PUBLIC_VERIFICATION_URL=http://localhost:5000/api/verification
CERTIFICATE_QR_KEY_ID=v1
CERTIFICATE_QR_PRIVATE_KEY_BASE64=
CERTIFICATE_QR_PUBLIC_KEYS={}
# Private VC keys are keyed by database issuer ID and must be generated/stored securely.
# Each entry contains publicKeyMultibase and secretKeyMultibase values.
VC_ISSUER_KEYS_JSON={{"42":{"publicKeyMultibase":"z6Mk...","secretKeyMultibase":"z..."}}
# Configure these values for claim invitation delivery. The worker stays disabled until all are set.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=2
